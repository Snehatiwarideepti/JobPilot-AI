# Git ignore rules
# ============================================================

# Environment variables - NEVER commit
.env
.env.local
.env.production

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
backend/.venv/
backend/.venv312/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.pnpm-store/

# Uploads (may contain user PII)
uploads/
backend/uploads/

# Database dumps
*.sql
*.dump

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker volumes
postgres_data/

# Logs
*.log
logs/

# Alembic - never auto-commit generated files blindly
# (keep migrations committed)

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Model cache (large)
.cache/
sentence_transformers_cache/
