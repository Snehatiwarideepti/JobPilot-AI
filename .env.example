# ============================================================
# JobPilot AI - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.

# ------------------------------------------------------------
# Job Provider API Keys
# ------------------------------------------------------------
JOBVETTA_API_KEY=your_jobvetta_api_key_here

# ------------------------------------------------------------
# LLM Provider
# ------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot_password@localhost:5432/jobpilot
DATABASE_SYNC_URL=postgresql://jobpilot:jobpilot_password@localhost:5432/jobpilot
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_password
POSTGRES_DB=jobpilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------
# Backend
# ------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_this_to_a_long_random_secret_key
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------
# File Upload
# ------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# ------------------------------------------------------------
# Retrieval Weights (must sum to 1.0)
# ------------------------------------------------------------
SEMANTIC_WEIGHT=0.55
SKILL_WEIGHT=0.20
EXPERIENCE_WEIGHT=0.15
LOCATION_WEIGHT=0.10

# ------------------------------------------------------------
# Embedding Model
# ------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ------------------------------------------------------------
# Evaluation Dataset
# ------------------------------------------------------------
EVAL_DATASET=wleeaf/career-site-job-postings-sample
